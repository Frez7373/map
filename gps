-- Настройки
local TARGET_HEIGHT = 100
local SIDE_OUTPUT = "top"
local CHECK_INTERVAL = 1 -- Интервал проверки в секундах

print("Программа контроля высоты запущена...")

while true do
    -- Получаем координаты через GPS
    local x, y, z = gps.locate(2)

    if not y then
        print("Ошибка: Не удалось получить GPS-сигнал.")
    else
        print("Текущая высота (Y): " .. y)

        -- Проверяем превышение высоты
        if y > TARGET_HEIGHT then
            redstone.setOutput(SIDE_OUTPUT, true)
        else
            redstone.setOutput(SIDE_OUTPUT, false)
        end
    end

    sleep(CHECK_INTERVAL)
end
